# Copie este arquivo para .env e preencha os segredos (nunca versionar o .env).
PORT=3000
# MySQL existente; informe as credenciais quando estiverem disponíveis.
DB_HOST=localhost
# Docker Desktop: host.docker.internal | Linux/VPS: endereço/IP acessível pelo contêiner
DB_HOST_DOCKER=host.docker.internal
DB_PORT=3305
DB_NAME=am_altto_calculator
DB_USER=
DB_PASSWORD=
APP_SECRET=gere-uma-chave-longa-aleatoria-com-openssl-rand-hex-32
DEMO_MODE=false
DEMO_PASSWORD=troque-esta-senha
COOKIE_SECURE=false
# Contas iniciais criadas automaticamente (somente se o login ainda não existir).
# Após a migração, é possível administrar contas pela interface.
USER_ADMIN_PASSWORD=troque-por-uma-senha-forte
USER_ADMIN_ROLE=admin
USER_VENDEDOR_PASSWORD=troque-por-outra-senha-forte
USER_VENDEDOR_ROLE=seller
# Opcional, para testar dois logins distintos no modo demonstração:
DEMO_ADMIN_PASSWORD=troque-esta-senha-de-admin
DEMO_SELLER_PASSWORD=troque-esta-senha-de-vendedor
